# Application port (uvicorn binds this port inside the container)
APP_PORT=8000
# Path to the SQLite database file
DATABASE_PATH=/data/events.db
# Lifetime in seconds of a consumer claim lease (positive integer)
LEASE_DURATION_SECONDS=30
# HMAC-SHA256 key used to sign event-history snapshot pagination cursors.
# The built-in default is for local development only; set a long random value
# in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# Rotating the value invalidates every cursor signed with the previous key.
SNAPSHOT_CURSOR_SECRET=dev-only-snapshot-cursor-secret-change-me
